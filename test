local function getParent()
    for _, fn in ipairs({gethui, get_hidden_gui, gethiddengui, get_hidden_ui, gethiddenui}) do
        if type(fn) == "function" then
            local ok, h = pcall(fn)
            if ok and typeof(h) == "Instance" then return h end
        end
    end
    return game:GetService("CoreGui") or Players.LocalPlayer:WaitForChild("PlayerGui")
end

local function mk(class, props, parent)
    local i = Instance.new(class)
    for k, v in pairs(props or {}) do i[k] = v end
    if parent then i.Parent = parent end
    return i
end

local function corner(inst, r)
    return mk("UICorner", {CornerRadius = typeof(r) == "UDim" and r or UDim.new(0, r or 10)}, inst)
end

local function stroke(inst, color, thick, trans)
    return mk("UIStroke", {
        Color = color or C.stroke,
        Thickness = thick or 1,
        Transparency = trans or T.stroke,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, inst)
end

local function pad(inst, t, r, b, l)
    return mk("UIPadding", {
        PaddingTop = UDim.new(0, t or 0),
        PaddingRight = UDim.new(0, r or t or 0),
        PaddingBottom = UDim.new(0, b or t or 0),
        PaddingLeft = UDim.new(0, l or r or t or 0),
    }, inst)
end

local function list(inst, gap, dir, halign, valign)
    return mk("UIListLayout", {
        Padding = UDim.new(0, gap or 0),
        FillDirection = dir or Enum.FillDirection.Vertical,
        SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = halign or Enum.HorizontalAlignment.Left,
        VerticalAlignment = valign or Enum.VerticalAlignment.Top,
    }, inst)
end

local function tw(obj, props, info)
    local a = TweenService:Create(obj, info or E.out, props)
    a:Play()
    return a
end

-- Creates a top-edge Fresnel glass reflection line on any frame
local function addSpecularRim(parent, inset, maxAlpha)
    inset = inset or 10
    maxAlpha = maxAlpha or 0.45
    local rim = mk("Frame", {
        Name = "SpecularRim",
        Size = UDim2.new(1, -inset * 2, 0, 1),
        Position = UDim2.fromOffset(inset, 0),
        BackgroundColor3 = C.specular,
        BackgroundTransparency = maxAlpha,
        BorderSizePixel = 0,
        Active = false,
        ZIndex = parent.ZIndex + 2,
    }, parent)
    local grad = mk("UIGradient", {
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(0.25, 0.25),
            NumberSequenceKeypoint.new(0.5, 0),
            NumberSequenceKeypoint.new(0.75, 0.25),
            NumberSequenceKeypoint.new(1, 1),
        }),
    }, rim)
    return rim, grad
end

-- Detects whether an icon is a Roblox Image Asset ID or a text symbol
local function resolveIcon(icon)
    if type(icon) == "number" then
        return true, "rbxassetid://" .. tostring(icon)
    end
    if type(icon) ~= "string" then
        return false, "◆"
    end
    local clean = icon:match("^%s*(.-)%s*$")
    if clean == "" then
        return false, "◆"
    end
    if clean:find("^rbxassetid://") or clean:find("^rbxthumb://") or clean:find("^https?://") then
        return true, clean
    end
    local digitsOnly = clean:match("^id://(%d+)$") or clean:match("^:?id://(%d+)$") or clean:match("^(%d+)$")
    if digitsOnly then
        return true, "rbxassetid://" .. digitsOnly
    end
    return false, clean
end

local function rippleClick(btn, x, y)
    task.spawn(function()
        local absPos = btn.AbsolutePosition
        local absSize = btn.AbsoluteSize
        local rx = x and (x - absPos.X) or (absSize.X * 0.5)
        local ry = y and (y - absPos.Y) or (absSize.Y * 0.5)

        local holder = mk("Frame", {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            ClipsDescendants = true,
            Active = false,
            ZIndex = btn.ZIndex + 1,
        }, btn)
        corner(holder, 9)

        local circle = mk("Frame", {
            Size = UDim2.fromOffset(0, 0),
            Position = UDim2.fromOffset(rx, ry),
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = C.accent,
            BackgroundTransparency = 0.72,
            BorderSizePixel = 0,
            Active = false,
            ZIndex = btn.ZIndex + 2,
        }, holder)
        corner(circle, 999)

        local maxDim = math.max(absSize.X, absSize.Y) * 2.2
        tw(circle, {
            Size = UDim2.fromOffset(maxDim, maxDim),
            BackgroundTransparency = 1,
        }, TweenInfo.new(0.42, Enum.EasingStyle.Quart, Enum.EasingDirection.Out))

        task.wait(0.45)
        if holder and holder.Parent then holder:Destroy() end
    end)
end

local function colorToHex(c)
    return string.format("#%02X%02X%02X",
        math.clamp(math.floor(c.R * 255 + 0.5), 0, 255),
        math.clamp(math.floor(c.G * 255 + 0.5), 0, 255),
        math.clamp(math.floor(c.B * 255 + 0.5), 0, 255)
    )
end

local function hexToColor(str)
    if type(str) ~= "string" then return nil end
    local clean = str:gsub("%s+", ""):gsub("^#", "")
    if #clean == 3 then
        clean = clean:sub(1, 1):rep(2) .. clean:sub(2, 2):rep(2) .. clean:sub(3, 3):rep(2)
    end
    if #clean ~= 6 then return nil end
    local r = tonumber(clean:sub(1, 2), 16)
    local g = tonumber(clean:sub(3, 4), 16)
    local b = tonumber(clean:sub(5, 6), 16)
    if r and g and b then return Color3.fromRGB(r, g, b) end
    return nil
end

local function parseKey(v)
    if typeof(v) == "EnumItem" then return v end
    if type(v) == "string" and v ~= "" and v ~= "None" then
        if v == "Mouse1" then return Enum.UserInputType.MouseButton1 end
        if v == "Mouse2" then return Enum.UserInputType.MouseButton2 end
        if v == "Mouse3" then return Enum.UserInputType.MouseButton3 end
        local okK, kc = pcall(function() return Enum.KeyCode[v] end)
        if okK and kc then return kc end
